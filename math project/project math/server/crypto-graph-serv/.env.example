PORT=4100

# Local MongoDB Community Server (no authentication by default).
DB_HOST=mongodb://127.0.0.1:27017/crypto_graph
DB_NAME=crypto_graph
DB_USER=crypto_graph
DB_PASS=crypto_graph_local

# Replace both values with long, unique local-development secrets.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRESIN=3600
JWT_REFRESH_SECRET=replace-with-another-long-random-secret
JWT_REFRESH_EXPIRESIN=604800

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4100/auth/google/callback
FRONTEND_URL=http://localhost:4000

# Gmail SMTP (requires a Google App Password; leave credentials empty until configured).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=